{
  "expo": {
    "name": "Olikit",
    "slug": "olikit",
    "version": "1.10.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "olikit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.abrorilhuda.olikit",
      "supportsTablet": false
    },
    "android": {
      "package": "com.abrorilhuda.olikit",
      "adaptiveIcon": {
        "backgroundColor": "#0d0f14",
        "foregroundImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d0f14",
          "image": "./assets/images/logo.png",
          "imageWidth": 120
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e2ca6533-ca4d-44de-8d4b-49d354e8ace2"
      }
    },
    "owner": "abrordc"
  }
}